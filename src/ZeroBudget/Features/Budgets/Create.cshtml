@page
@model ZeroBudget.Features.Budgets.CreateModel
@{
}
<h2>Create Budget</h2>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<form method="post" asp-antiforgery="true">
    <div class="mb-3">
        <label asp-for="BudgetDefinition.Name" class="form-label"></label>
        <input asp-for="BudgetDefinition.Name" class="form-control" />
        <span asp-validation-for="BudgetDefinition.Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">
        Save
    </button>
    <button type="button" class="btn btn-secondary" onclick="Cancel()">Cancel</button>
</form>
<script>
    function Cancel() {
        window.location.href = '@Url.Page("Index")';
    }
</script>