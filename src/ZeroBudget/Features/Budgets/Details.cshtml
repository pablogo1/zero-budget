@page "{key}"
@model ZeroBudget.Features.Budgets.DetailsModel
@{
}
<h2>@Model.BudgetName</h2>
<div class="p-3 mb-3 bg-light border rounded d-flex flex-row-reverse">
    <div class="p-2">
        <a class="btn btn-secondary" asp-page="./Index">Back to List</a>
    </div>
    <div class="p-2">
        <a class="btn btn-primary" asp-page="./Edit" asp-route-key="@Model.BudgetDetail.Key">Edit Budget</a>
    </div>
</div>

<h3>Income</h3>
<table class="table table-striped table-bordered">
    <thead class="thead-light">
        <tr>
            <th>&nbsp;</th>
            @foreach (var partial in Model.BudgetDetail)
            {
                <th>@partial.Name</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var income in Model.BudgetDetail.PartialBudgets)
        {
            <tr>
                <td>@income.Name</td>
                <td>@income.PlannedAmount.ToString("C")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td><strong>Total</strong></td>
            <td><strong>@Model.BudgetDetail.Income.TotalPlannedAmount.ToString("C")</strong></td>
        </tr>
    </tfoot>
</table>

<h3>Expenses</h3>
<table class="table table-striped table-bordered">
    <thead class="thead-light">
        <tr>
            <th>Category Name</th>
            <th>Planned Amount</th>
            <th>Current Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var expense in Model.BudgetDetail.Expenses.Items)
        {
            <tr>
                <td>@expense.Name</td>
                <td>@expense.PlannedAmount.ToString("C")</td>
                <td>@expense.ActualAmount.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>