@page
@model ZeroBudget.Features.Budgets.IndexModel
@{
    ViewData["Title"] = "Budgets";
    ViewData["ActivePage"] = "Budgets";
}
<div class="text-right">
    <a class="btn btn-primary" asp-page="./Create">Create New Budget</a>
</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Budget</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var budget in Model.Budgets)
        {
            <tr>
                <td>@budget.Month @budget.Year</td>
                <td>
                    <a asp-page="./Details" asp-route-key="@budget.Key">Details</a> |
                    <a asp-page="./Edit" asp-route-key="@budget.Key">Edit</a> |
                    <a asp-page="./Delete" asp-route-key="@budget.Key">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>